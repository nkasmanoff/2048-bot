# LLM Agent Configuration
# Copy this file to .env and fill in your values

# API Key (required for LLM agent)
# For OpenRouter (supports many models including open source)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Or for OpenAI directly
# OPENAI_API_KEY=your-openai-api-key-here

# Model name (optional, defaults to gpt-4o-mini if not set)
# OpenRouter examples:
LLM_MODEL=allenai/olmo-3-7b-instruct
# LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_MODEL=google/gemini-2.0-flash-thinking-exp:free

# OpenAI examples:
# LLM_MODEL=gpt-4o
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gpt-3.5-turbo

# Base URL (optional, required for OpenRouter and other API providers)
# For OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1

# For OpenAI (leave empty or omit):
# LLM_BASE_URL=

# For other OpenAI-compatible APIs:
# LLM_BASE_URL=https://your-api-endpoint.com/v1

